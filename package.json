{
  "name": "event-support-tracker-firebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Firestore security rules and indexes for Event Support Tracker (iOS + Android)",
  "scripts": {
    "test": "firebase emulators:exec --only firestore \"node --test tests/\"",
    "test:watch": "firebase emulators:exec --only firestore \"node --test --watch tests/\"",
    "emulators": "firebase emulators:start --only firestore",
    "deploy:prod": "firebase deploy --only firestore:rules,firestore:indexes --project prod"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
