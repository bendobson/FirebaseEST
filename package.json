{
  "name": "event-support-tracker-firebase",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore security rules and indexes for Event Support Tracker (iOS + Android)",
  "scripts": {
    "test": "firebase emulators:exec --project demo-eventsupporttracker --only firestore,storage \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:watch": "firebase emulators:exec --project demo-eventsupporttracker --only firestore,storage \"node --test --watch tests/\"",
    "emulators": "firebase emulators:start --project demo-eventsupporttracker --only firestore",
    "deploy:prod": "firebase deploy --only firestore:rules,firestore:indexes,storage --project prod",
    "audit": "node scripts/firestore-audit.js",
    "deploy:develop": "firebase deploy --only firestore:rules,firestore:indexes,storage --project develop"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-admin": "^13.8.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
