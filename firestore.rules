rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────
    // Helper Functions
    // ───────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return userDoc().data != null;
    }

    function isProUser() {
      return hasUserDoc() && userDoc().data.isProUser == true;
    }

    function userEventCount() {
      return hasUserDoc() && ("eventCount" in userDoc().data)
        ? userDoc().data.eventCount
        : 0;
    }

    function isOwner(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.ownerUserId
        == request.auth.uid;
    }

    function hasAccess(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/access/$(request.auth.uid));
    }

    function userRole(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/access/$(request.auth.uid)).data.role;
    }

    function canRead(eventId) {
      return isOwner(eventId) || hasAccess(eventId);
    }

    function canWrite(eventId) {
      return isOwner(eventId) || userRole(eventId) == "editor";
    }

    // ───────────────────────────────────────────────
    // Users
    // ───────────────────────────────────────────────
    match /users/{uid} {

      // Only the authenticated user may read their own profile
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow get: if isSignedIn() && request.auth.uid == uid;
      // Allow querying visible users (for invite search)
  		allow list: if isSignedIn() && resource.data.profileVisible == true;

      // Create:
      // - Must be signed in
      // - Must be creating their own doc
      // - Doc must NOT already exist (prevents overwriting)
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/users/$(uid));

      // Update:
      // - Must be signed in
      // - Must be updating their own doc
      // - Doc must already exist (prevents accidental create-via-update)
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && exists(/databases/$(database)/documents/users/$(uid));

      // Delete:
      // - User may delete their own profile
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ───────────────────────────────────────────────
    // Events
    // ───────────────────────────────────────────────

    // Required for queries on /events
    match /events {
      allow list: if isSignedIn();
    }

    match /events/{eventId} {

      function isOwnerOfCurrentEvent() {
        return resource.data.ownerUserId == request.auth.uid;
      }

      function canReadCurrentEvent() {
        return isOwnerOfCurrentEvent() || hasAccess(eventId);
      }

      function canWriteCurrentEvent() {
        return isOwnerOfCurrentEvent() || userRole(eventId) == "editor";
      }

      // Create: owner must match, and the free tier is one event.
      //
      // `< 1`, not `<= 1`. The counter is incremented after a create, so a free user with one
      // event already has eventCount == 1 — `<= 1` let them make a second. That looser value
      // was test residue. This now matches SubscriptionManager.canCreateEvent, which is
      // `isProUser || eventCount < 1`.
      allow create: if isSignedIn()
                    && request.resource.data.ownerUserId == request.auth.uid
                    && (isProUser() || userEventCount() < 1);

      // Read / query
      allow get, list, read: if isSignedIn() && canReadCurrentEvent();

      // Update: owner or editor. ownerUserId never changes after create (audit, Oct 2026):
      // Android's migrateStaleOwnerUserId used an editor's write to take ownership (JCW D2,
      // live). iOS guest migration also rewrites it, but that write is already refused here,
      // because the new account is neither owner nor editor of the guest's events.
      allow update: if isSignedIn()
                    && canWriteCurrentEvent()
                    && request.resource.data.ownerUserId == resource.data.ownerUserId;

      // Delete: only owner + pro
      allow delete: if isSignedIn() && isOwnerOfCurrentEvent() && isProUser();
    }
    
    // ───────────────────────────────────────────────
    // Event Access
    // ───────────────────────────────────────────────
    match /events/{eventId}/access/{accessId} {

      // Any member of the event can list access docs
      allow list: if isSignedIn() && canRead(eventId);

      // Individual doc: user can read their own
      allow get: if isSignedIn() && request.auth.uid == accessId;

      // Only the event owner can grant or modify access, and the doc must be well formed
      // (audit, Oct 2026):
      // - `id` equals the doc ID, because shared-event discovery (the collection-group rule
      //   below) filters on it.
      // - The role is "editor" or "viewer". "owner" only on the event owner's own doc: an
      //   access-doc owner who isn't ownerUserId gets no write access from these rules, so
      //   granting it (iOS offers it) silently made someone read-only.
      allow create, update: if isSignedIn()
                            && isOwner(eventId)
                            && request.resource.data.id == accessId
                            && validRoleFor(eventId, accessId, request.resource.data.role);

      // Event owner or the user themselves can revoke
      allow delete: if isSignedIn() && (isOwner(eventId) || request.auth.uid == accessId);
    }

    function validRoleFor(eventId, accessId, role) {
      return role in ["editor", "viewer"]
        || (role == "owner"
            && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUserId == accessId);
    }

    // Shared Event Discovery — collection group query
    // Uses resource.data.id because for LIST queries Firestore
    // evaluates field data, not the path wildcard
    match /{path=**}/access/{accessId} {
      allow get: if isSignedIn() && request.auth.uid == accessId;
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
    }
    
    // ───────────────────────────────────────────────
    // Checkpoints
    // ───────────────────────────────────────────────
    match /events/{eventId}/checkpoints/{detailId} {
      allow read: if isSignedIn() && canRead(eventId);
      allow create, update, delete: if isSignedIn() && canWrite(eventId);
    }

    // ───────────────────────────────────────────────
    // Paces
    // ───────────────────────────────────────────────
    match /events/{eventId}/paces/{paceId} {
      allow read: if isSignedIn() && canRead(eventId);
      allow create, update, delete: if isSignedIn() && canWrite(eventId);
    }

  }
}
